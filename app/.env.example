# Copy to .env and fill in. .env is git-ignored and never shipped to the frontend.

# HTTP port
PORT=3000

# Tide provider: "apimaree", "worldtides" or "mock" (offline synthetic).
# "auto" (default) uses api-maree.fr when TIDE_API_KEY is set, otherwise mock.
TIDE_PROVIDER=auto

# API key for the tide provider. Kept server-side only — the browser never sees it.
# api-maree.fr: get one at https://api-maree.fr/
TIDE_API_KEY=

# api-maree.fr site identifier (see https://api-maree.fr/sites).
TIDE_SITE=ploumanac-h

# Datum of the values exposed by this application after applying the offset.
# api-maree.fr supplies ZH heights; the Ploumanac'h offset below converts them
# to IGN69 so they can be combined with the LITTO3D elevations.
TIDE_DATUM=IGN69

# Altitude of Ploumanac'h's hydrographic zero in IGN69, from Shom RAM:
# H(IGN69) = H(ZH) - 5.045 m.
TIDE_DATUM_OFFSET=-5.045

# Optional: enables the official Google Maps satellite view. The Map Tiles API
# must be enabled on a billing-enabled Google Cloud project.
GOOGLE_MAPS_API_KEY=
    
